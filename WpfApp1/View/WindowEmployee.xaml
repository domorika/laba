<Window x:Class="WpfApp1.View.WindowEmployee"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp1.View"
        mc:Ignorable="d"
        Title="Сотрудники" Height="450" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Background="#FFE4E0E0">
            <Button Content="Добавить" Margin="10,10,5,10" Height="25"
                    Command="{Binding AddPerson}"/>
            <Button Content="Редактировать" Margin="10,10,5,10" Height="25"
                    Command="{Binding EditPerson}"/>
            <Button Content="Удалить" Margin="10,10,5,10" Height="25"
                    Command="{Binding DeletePerson}"/>
        </StackPanel>

        <ListView x:Name="EmployeesListView" Grid.Row="1" 
          ItemsSource="{Binding ListPersonDpo, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
          SelectedItem="{Binding SelectedPersonDpo, Mode=TwoWay}">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Код" Width="50" DisplayMemberBinding="{Binding Id}"/>
                    <GridViewColumn Header="Фамилия" Width="120" DisplayMemberBinding="{Binding LastName}"/>
                    <GridViewColumn Header="Имя" Width="120" DisplayMemberBinding="{Binding FirstName}"/>
                    <GridViewColumn Header="Должность" Width="150" DisplayMemberBinding="{Binding Role}"/>
                    <GridViewColumn Header="Дата рождения" Width="100" DisplayMemberBinding="{Binding Birthday, StringFormat={}{0:dd.MM.yyyy}}"/>
                </GridView>
            </ListView.View>
        </ListView>
    </Grid>
</Window>