<Window x:Class="WpfApp1.View.WindowRole"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp1.View"
        mc:Ignorable="d"
        Title="Должности" Height="450" Width="600">

    <StackPanel Background="#FFD8D8D8">
        <StackPanel Orientation="Horizontal" Background="#FFE4E0E0">
            <Button Content="Добавить" Margin="10,10,5,10" Height="25"
                    Command="{Binding AddRole}"/>
            <Button Content="Редактировать" Margin="10,10,5,10" Height="25"
                    Command="{Binding EditRole}"/>
            <Button Content="Удалить" Margin="10,10,5,10" Height="25"
                    Command="{Binding DeleteRole}"/>
        </StackPanel>

        <Label Margin="5" HorizontalAlignment="Center">Список должностей сотрудников</Label>

        <ListView ItemsSource="{Binding ListRoles}" SelectedItem="{Binding SelectedRole}" Background="#FFD3CDCD">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Код" Width="50" DisplayMemberBinding="{Binding Id}"/>
                    <GridViewColumn Header="Наименование должности" Width="200" DisplayMemberBinding="{Binding NameRole}"/>
                </GridView>
            </ListView.View>
        </ListView>
    </StackPanel>
</Window>
